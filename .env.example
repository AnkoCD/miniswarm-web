# Application
APP_ENV=development
APP_NAME=MiniSwarm Web
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=10080
COOKIE_SECURE=false

# Infrastructure
POSTGRES_PASSWORD=change-me-before-production
DATABASE_URL=postgresql+psycopg://miniswarm:change-me-before-production@postgres:5432/miniswarm
POSTGRES_LOCAL_PORT=15432
REDIS_URL=redis://redis:6379/0
DATA_ROOT=/data
RUNNER_URL=http://runner:8100
SKILL_MANAGER_URL=http://skill-manager:8200
SKILLS_ROOT=/skills
# Optional. Create at https://anysearch.com/console/api-keys
ANYSEARCH_API_KEY=
MAX_SKILLS_PER_NODE=3
MAX_SKILL_CONTEXT_CHARS=120000
# Generate independently from JWT_SECRET; use at least 32 random characters.
RUNNER_SHARED_SECRET=replace-with-a-separate-runner-secret
# Used only between the API/Agent and the isolated Skill Manager.
SKILL_MANAGER_SHARED_SECRET=replace-with-a-separate-skill-manager-secret

# Bootstrap (only used by the explicit bootstrap command)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# DeepSeek (never expose this value to the frontend)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_ORCHESTRATOR=deepseek-v4-pro
MODEL_REVIEWER=deepseek-v4-pro
MODEL_WORKER=deepseek-v4-flash
MODEL_MEMORY=deepseek-v4-pro

# Small-team limits
MAX_USERS=3
MAX_ACTIVE_TASKS=3
MAX_ACTIVE_TASKS_PER_USER=1
MAX_AGENTS_PER_TASK=12
MAX_GLOBAL_AGENTS=16
MAX_CONCURRENT_AGENTS_PER_TASK=8
CONTROL_CONCURRENCY=1
SUPERVISOR_CONCURRENCY=1
PLANNER_CONCURRENCY=1
CHAT_CONCURRENCY=2
MAX_AGENT_DEPTH=1
MAX_AGENT_ROUNDS=40
MAX_REVIEW_RETRIES=3
MAX_TOOL_CALLS_PER_TASK=240
MAX_MEMORIES_PER_USER=500
MAX_MEMORY_CONTEXT_CHARS=6000
TASK_TIMEOUT_MINUTES=45
AGENT_TIMEOUT_MINUTES=20
RUNNER_CONCURRENCY=2
MAX_UPLOAD_MB=100
MAX_TASK_STORAGE_MB=1024
MAX_PROJECT_STORAGE_GB=5
MESSAGE_CHECKPOINT_CHARS=600
